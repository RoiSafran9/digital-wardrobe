GEMINI_API_KEY=

# Multi-user backend (off by default: the local single-owner API runs as before).
# WARDROBE_AUTH=on
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SECRET_KEY=            # sb_secret_... — server only, never in mobile/
# SUPABASE_PUBLIC_URL=http://<your-Mac-LAN-IP>:54321   # host the phone uses for signed image URLs
# SUPABASE_JWT_ISSUER=            # defaults to $SUPABASE_URL/auth/v1
# WARDROBE_BILLING=on              # AI Credits billing; off unless exactly "on" (needs every action priced below)
# WARDROBE_CREDIT_PRICES=          # AI Credits per action, e.g. {"garment": <n>, "back": <n>, "turn": <n>}; used only with WARDROBE_BILLING=on
