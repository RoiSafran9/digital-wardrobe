GEMINI_API_KEY=

# Multi-user backend (off by default: the local single-owner API runs as before).
# WARDROBE_AUTH=on
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SECRET_KEY=            # sb_secret_... — server only, never in mobile/
# SUPABASE_PUBLIC_URL=http://<your-Mac-LAN-IP>:54321   # host the phone uses for signed image URLs
# SUPABASE_JWT_ISSUER=            # defaults to $SUPABASE_URL/auth/v1
# WARDROBE_BILLING=on              # AI Credits billing; off unless exactly "on" (needs every action priced below)
# WARDROBE_CREDIT_PRICES=          # AI Credits per action, e.g. {"garment": <n>, "back": <n>, "turn": <n>}; used only with WARDROBE_BILLING=on
# WARDROBE_OUTFIT=on               # Outfit Photo M1 scan API (/v1/outfit-scans); experimental, off unless exactly "on"

# Beta controls (all optional; see api/controls.py)
# WARDROBE_GENERATION=off              # pause all new AI work; the closet stays usable
# WARDROBE_FREE_SCANS_PER_HOUR=30      # free scans (garment pre-scans, outfit scans) per account per hour
# WARDROBE_WELCOME_CREDITS=            # one-time welcome grant per invited account; empty = off (amount not approved yet)
# WARDROBE_BETA_INVITES=               # "*" or a comma list of emails and @domains that get the welcome grant
# WARDROBE_DAILY_AI_JOBS=              # hard cap on paid AI jobs per UTC day across all accounts (cost guard)
# WARDROBE_SWEEP_EVERY_HOURS=          # run the Storage cleanup in the worker this often (e.g. 6); empty = never
