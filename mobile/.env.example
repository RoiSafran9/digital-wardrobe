# Copy to mobile/.env (git-ignored). Leave both blank to run in local mode during development.
# Use the project's PUBLISHABLE key (sb_publishable_...). Never put a secret/service-role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Local Supabase CLI stack (npx supabase start): the phone needs your Mac's LAN IP, e.g.
# EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.20:54321
# Optional: override the wardrobe server address (otherwise derived from Expo's host).
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8000
