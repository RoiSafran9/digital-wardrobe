{
  "expo": {
    "name": "KIPS",
    "slug": "mobile",
    "version": "1.0.0",
    "scheme": "wardrobe",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.roisafran.kips"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F6BFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-asset",
      "expo-font",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "KIPS uses the camera to photograph your clothes and turn them into catalog images.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "KIPS reads the photos you choose so it can turn the clothes in them into catalog images.",
          "cameraPermission": "KIPS uses the camera to photograph your clothes and turn them into catalog images."
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "46d0a26e-2edf-4491-bbfd-f0742b6c2e8c"
      }
    },
    "owner": "roisafran"
  }
}
